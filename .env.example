# Optional first-time administrator initialization. No default password.
# Copy to .env, choose a password of 12 or more characters, then start the web service.
# Remove HUZHAN_ADMIN_PASSWORD after the account is created; reset existing accounts via CLI.
HUZHAN_ADMIN_USERNAME=admin
HUZHAN_ADMIN_PASSWORD=
# Set to 1 when the public site uses HTTPS; leave 0 for local HTTP access.
HUZHAN_COOKIE_SECURE=0
